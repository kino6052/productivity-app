# Copy to .env and fill in with real values from the Firebase console
# (Project settings > General > Your apps). .env is gitignored -- never
# commit it. These are Firebase *web* config values, not secrets by
# Google's own design (see packages/adapters-firebase/src/firebase-config.ts),
# but they live here rather than in source per project convention.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
