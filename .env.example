# Copy to .env and fill in with real values from the Firebase console
# (Project settings > General > Your apps). .env is gitignored -- never
# commit it. These are Firebase *web* config values, not secrets by
# Google's own design (see packages/adapters-firebase/src/firebase-config.ts),
# but they live here rather than in source per project convention.
#
# VITE_ prefix required: Vite only exposes prefixed vars to client bundles
# (packages/app), and Bun mirrors process.env into import.meta.env under
# the same names either way, so one prefix covers both consumers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
